{
  "name": "@vibeinging/dsh-office-tools",
  "description": "Session-scoped Office artifact tools for a DSH host implementing officeArtifactHost",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "portability": {
      "level": "desktop-adapter",
      "surfaces": ["dsh-desktop"],
      "hostRequirements": ["office-artifact-host"]
    }
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4"
  }
}
