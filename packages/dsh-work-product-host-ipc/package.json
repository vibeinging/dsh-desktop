{
  "name": "@vibeinging/dsh-work-product-host-ipc",
  "description": "Narrow DSH Desktop Host adapter for product and Browser Workspace capabilities",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "portability": {
      "level": "desktop-adapter",
      "surfaces": ["dsh-desktop"],
      "hostRequirements": ["dsh-work-parent-ipc", "browser-workspace-host"]
    }
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  }
}
