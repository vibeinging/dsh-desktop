{
  "name": "@deepseek-ai/dsh-workbench-pages",
  "description": "Profile-owned DeepSeek Harness Desktop App workbench page catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./product.json": "./product.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "product": "./product.json",
    "portability": {
      "level": "desktop-adapter",
      "surfaces": ["dsh-desktop"],
      "hostRequirements": ["dsh-workbench-slot"]
    }
  },
  "files": [
    "src/index.js",
    "product.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
