{
  "name": "@vibeinging/dsh-model-inheritance",
  "description": "Portable parent-to-sub-Agent model inheritance for DSH Profiles",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "portability": {
      "level": "portable",
      "surfaces": [
        "official-web",
        "dsh-desktop"
      ],
      "hostRequirements": [],
      "compatibilityTest": "eval/tests/dsh-official-web-plugin-compat.test.mjs"
    }
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1"
  }
}