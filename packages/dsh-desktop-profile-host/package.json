{
  "name": "@vibeinging/dsh-desktop-profile-host",
  "description": "DSH Desktop profile identity and controlled package-manager services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWork": {
    "portability": {
      "level": "desktop-adapter",
      "surfaces": ["dsh-desktop"],
      "hostRequirements": ["dsh-profile-filesystem", "controlled-pnpm-runtime", "dsh-cli-runtime"]
    }
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
