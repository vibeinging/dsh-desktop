{
  "name": "@vibeinging/dsh-client-ui-worktree",
  "description": "Git Worktree sessions through official DSH Web slots",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:client": "node ./scripts/build-client.mjs"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./git": "./src/git.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dshWork": {
    "portability": {
      "level": "portable",
      "surfaces": [
        "official-web",
        "dsh-desktop"
      ],
      "hostRequirements": [],
      "compatibilityTest": "eval/tests/dsh-worktree.test.mjs"
    }
  },
  "files": [
    "src/index.js",
    "src/git.js",
    "src/client/index.js",
    "lib/client.js",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.1",
    "react": "^18.3.1"
  }
}